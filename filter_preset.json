{
  "presets": {
    "errors_only": {
      "description": "Show only ERROR and WARN level logs",
      "logLevelInclude": ["ERROR", "WARN"]
    },
    "exclude_noisy_threads": {
      "description": "Exclude common noisy threads",
      "threadExclude": ["Timer-", "pool-", "Scheduler-"]
    },
    "device_lifecycle": {
      "description": "Focus on device lifecycle components",
      "componentInclude": [
        "ASKMDwsDeviceLifecycleProviderImpl",
        "ASRicohDwsDeviceLifecycleProviderImpl",
        "DwsCoreDeviceLifecycleManagerImpl"
      ]
    },
    "exclude_html": {
      "description": "Exclude HTML log files",
      "filenameExclude": ["*.html"]
    },
    "production_errors": {
      "description": "Production errors excluding noisy components",
      "logLevelInclude": ["ERROR", "FATAL"],
      "componentExclude": ["OMSessionManagementImpl"],
      "threadExclude": ["Timer-"]
    },
    "device_debug": {
      "description": "Debug logs for specific device",
      "logLevelInclude": ["DEBUG", "TRACE"],
      "deviceInclude": ["TC101514400004"]
    }
  }
}
